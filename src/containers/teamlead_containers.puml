@startuml teamlead_containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров (Level 2) — Аналитическая платформа DemoScope

Person(analyst, "Демограф-аналитик", "Основной пользователь: анализирует показатели, строит прогнозы и сравнивает территории")
Person(official, "Сотрудник органа гос. управления", "Использует «радар проблем» и аналитические отчёты для принятия управленческих решений")
Person(researcher, "Исследователь / студент", "Изучает демографическую динамику регионов РФ и выгружает аналитические справки")

System_Boundary(demoscope, "DemoScope") {
    Container(web_app, "Веб-приложение (SPA)", "React 19, TypeScript, Vite, Tailwind CSS", "Одностраничное клиентское приложение в браузере: интерактивные дашборды, карты регионов, графики прогнозов и конструктор отчётов")
    Container(mobile_app, "Мобильное приложение", "React Native, TypeScript", "Мобильный клиент для сотрудников госорганов и аналитиков: оперативный просмотр ключевых метрик, «радара проблем» и готовых сводок")
    Container(api_backend, "Backend API", "Python 3.10, FastAPI, Pandas, Statsmodels", "Серверное приложение: REST API, расчёт демографических коэффициентов, статистическое прогнозирование (ARIMA, Хольт-Уинтерс, когортно-компонентный метод), кластеризация регионов и формирование отчётов")
    Container(data_pipeline, "Конвейер подготовки данных", "Python 3.10, Pandas, PyArrow, gdown", "Пакетный ETL-модуль: загрузка сырых таблиц из внешних источников, очистка, нормализация кодов ОКАТО/ОКТМО и конвертация в колоночный формат")
    ContainerDb(data_store, "Хранилище демографических данных", "Apache Parquet (PyArrow), файловая система (~6 ГБ)", "Локальное колоночное хранилище (Data Lake): предобработанные временные ряды рождаемости, смертности, миграции и возрастной структуры по регионам РФ")
    ContainerDb(db_service, "Служебная БД", "PostgreSQL 16", "Реляционная база данных: профили пользователей, сохранённые сценарии прогнозов, кэш расчётов и история сгенерированных отчётов")
}

System_Ext(rosstat, "Росстат", "Официальные витрины демографической статистики РФ")
System_Ext(emiss, "ЕМИСС", "Единая межведомственная информационно-статистическая система")
System_Ext(gdrive, "Google Drive", "Облачное хранилище исходных архивов демографических данных (CSV)")
System_Ext(gemini_api, "Google Gemini API", "Внешний LLM-сервис для генерации текстовых аналитических заключений")

Rel(analyst, web_app, "Работает с интерактивными дашбордами, настраивает модели прогноза и формирует отчёты", "HTTPS")
Rel(official, web_app, "Просматривает сводные дашборды, карту рисков и аналитические отчёты", "HTTPS")
Rel(official, mobile_app, "Оперативно просматривает ключевые индикаторы и уведомления «радара проблем»", "HTTPS")
Rel(researcher, web_app, "Изучает графики, сравнивает территории и экспортирует таблицы", "HTTPS")

Rel(web_app, api_backend, "Запрашивает демографические ряды, расчёт прогнозов, кластеризацию и генерацию отчётов", "HTTPS/JSON (REST API)")
Rel(mobile_app, api_backend, "Запрашивает сводные показатели регионов, «радар проблем» и готовые аналитические сводки", "HTTPS/JSON (REST API)")

Rel(api_backend, data_store, "Выполняет быстрые колоночные выборки демографических временных рядов с предикатной фильтрацией", "Файловый I/O (PyArrow / Parquet)")
Rel(api_backend, db_service, "Читает и сохраняет пользовательские сценарии, кэш прогнозов и метаданные отчётов", "SQL/TCP (asyncpg, порт 5432)")
Rel(api_backend, gemini_api, "Передаёт рассчитанные статистические показатели в промпте и получает аналитическое резюме", "HTTPS/JSON (REST API)")

Rel(data_pipeline, rosstat, "Выгружает обновления официальных демографических таблиц", "HTTPS/REST, CSV/XLSX")
Rel(data_pipeline, emiss, "Выгружает региональные статистические ряды", "HTTPS/REST, CSV/SDMX")
Rel(data_pipeline, gdrive, "Скачивает архивы исходных демографических наборов данных", "HTTPS (gdown)")
Rel(data_pipeline, data_store, "Записывает очищенные и партиционированные таблицы в колоночном формате", "Файловый I/O (PyArrow / Parquet)")

@enduml
