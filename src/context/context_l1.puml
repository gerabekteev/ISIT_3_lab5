@startuml context_l1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Диаграмма системного контекста (Level 1) — Аналитическая платформа DemoScope

Person(analyst, "Демограф-аналитик", "Основной пользователь: анализирует демографические показатели, строит прогнозы рождаемости, смертности и миграции, сравнивает территории")
Person(official, "Сотрудник органа гос. управления", "Потребитель аналитики: использует «радар проблем», отчёты и прогнозы для принятия управленческих решений в социальной сфере")
Person(researcher, "Исследователь / студент", "Изучает демографическую динамику регионов РФ, выгружает аналитические справки и графики для научных работ")

System(demoscope, "DemoScope", "Информационная система аналитического мониторинга и прогнозирования динамики населения РФ: агрегация данных, расчёт коэффициентов, прогнозирование и генерация отчётов")

System_Ext(rosstat, "Росстат", "Федеральная служба государственной статистики: официальные демографические показатели, итоги переписей, половозрастной состав")
System_Ext(emiss, "ЕМИСС", "Единая межведомственная информационно-статистическая система: государственные статистические ряды по регионам РФ")
System_Ext(gemini_api, "Google Gemini API", "Внешний облачный сервис большой языковой модели (LLM) для автоматической генерации аналитических заключений и текстовых выводов")
System_Ext(gdrive, "Google Drive", "Облачное файловое хранилище с исходными наборами демографических данных (архивы CSV)")

Rel(analyst, demoscope, "Анализирует показатели, настраивает параметры моделей, запрашивает прогнозы и отчёты", "HTTPS")
Rel(official, demoscope, "Просматривает дашборды, карту рисков («радар проблем») и сводные отчёты по регионам", "HTTPS")
Rel(researcher, demoscope, "Изучает временные ряды, половозрастные пирамиды и скачивает аналитические материалы", "HTTPS")

Rel(demoscope, rosstat, "Загружает официальные демографические ряды и статистические бюллетени", "HTTPS/REST, CSV/XLSX")
Rel(demoscope, emiss, "Получает открытые статистические показатели по субъектам РФ", "HTTPS/REST, CSV/SDMX")
Rel(demoscope, gdrive, "Скачивает предобработанные архивы демографических таблиц при инициализации хранилища", "HTTPS (gdown)")
Rel(demoscope, gemini_api, "Отправляет агрегированные метрики и получает сгенерированный текст аналитического заключения", "HTTPS/JSON (REST API)")

@enduml
