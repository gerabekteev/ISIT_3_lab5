@startuml dynamic_process
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Dynamic.puml

LAYOUT_WITH_LEGEND()

title Динамическая диаграмма — сквозной сценарий «Построение прогноза численности населения региона» (Сырлыбаев Б.С.)

Person(analyst, "Демограф-аналитик", "Запускает расчёт прогноза")
Container(web_app, "Веб-приложение (SPA)", "React 19 / Vite", "Клиентский интерфейс")

Container_Boundary(api_backend, "Backend API (Python 3.10 / FastAPI)") {
    Component(api_router, "API Router", "FastAPI Router, Pydantic", "Маршрутизация REST-запросов, валидация схем")
    Component(forecast_service, "Сервис прогнозирования", "Statsmodels", "Оркестрация алгоритмов прогнозирования")
    Component(data_repo, "Репозиторий данных", "PyArrow / Parquet", "Слой доступа к озеру данных")
    Component(db_repo, "Репозиторий служебной БД", "SQLAlchemy", "Слой доступа к служебной БД")
}

ContainerDb(data_store, "Хранилище демографических данных", "Parquet / PyArrow, файловая система", "Временные ряды Росстата и ЕМИСС")
ContainerDb(db_service, "Служебная БД", "PostgreSQL 16", "Кэш результатов прогнозов")

RelIndex(1, analyst, web_app, "Задаёт параметры прогноза: регион, горизонт, сценарий", "HTTPS")
RelIndex(2, web_app, api_router, "Запрос прогноза (POST /api/forecast)", "HTTPS/JSON")
RelIndex(3, api_router, forecast_service, "Вызов run_forecast(region, horizon, model_type)", "Python Call")
RelIndex(4, forecast_service, db_repo, "Поиск результата в кэше прогнозов", "Python Call")
RelIndex(5, db_repo, db_service, "Запрос SELECT по ключу прогноза", "SQL/TCP 5432")
RelIndex(6, forecast_service, data_repo, "Запрос исторического ряда", "Python Call")
RelIndex(7, data_repo, data_store, "Чтение Parquet-фрагментов", "Файловый I/O (Parquet)")
RelIndex(8, forecast_service, db_repo, "Сохранение рассчитанного прогноза в кэш", "Python Call")
RelIndex(9, db_repo, db_service, "Запрос INSERT в кэш прогнозов", "SQL/TCP 5432")
RelIndex(10, forecast_service, api_router, "Возврат структуры ForecastResult", "Python Call")
RelIndex(11, api_router, web_app, "HTTP 200 OK: прогноз с доверительными интервалами", "HTTPS/JSON")
RelIndex(12, web_app, analyst, "Отображение графика прогноза и доверительных интервалов", "HTTPS")

@enduml
